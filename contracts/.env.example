# --- Deployer ---
PRIVATE_KEY=0xyour_deployer_private_key_here

# --- Arc Testnet ---
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARCSCAN_API_KEY=

# --- Ethereum Sepolia (collateral vault chain, for now — see DeploySepolia.s.sol) ---
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key

# --- Ethereum mainnet (future production vault chain — real ETH gas, real NFT custody once
# Arc itself is out of testnet — see DeployMainnet.s.sol) ---
ETH_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key

# --- Roles (set after deploy, or pass to deploy scripts) ---
# Address that signs eligibility attestations (the oracle-service signer)
TRUSTED_ATTESTOR_ADDRESS=
# Address authorized to call unlockCollateral/seizeCollateral and report repay/default (the oracle-service relayer)
TRUSTED_RELAYER_ADDRESS=

# --- Arc USDC token address (native USDC ERC-20 interface on Arc Testnet) ---
# See https://testnet.arcscan.app for the current address, or arc/references/contract-addresses in the Arc docs
ARC_USDC_ADDRESS=

# --- Deployed contract addresses (fill in after running the deploy scripts) ---
LENDING_POOL_ADDRESS=
REWARD_TOKEN_ADDRESS=
COLLATERAL_VAULT_ADDRESS=
