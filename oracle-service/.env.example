# --- Server ---
PORT=8787

# --- Chains ---
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key
ETH_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key

# --- Deployed contracts (fill in after `forge script` deploys) ---
LENDING_POOL_ADDRESS=
COLLATERAL_VAULT_ADDRESS=

# --- Attestor signer (issues EIP-712 eligibility attestations) ---
# Must match TRUSTED_ATTESTOR_ADDRESS used when deploying LendingPool.
ATTESTOR_PRIVATE_KEY=0xyour_attestor_private_key

# --- Relayer signer (calls unlockCollateral/seizeCollateral on Sepolia) ---
# Must match TRUSTED_RELAYER_ADDRESS used when deploying CollateralVault.
# Needs a small Sepolia ETH balance for gas (testnet faucet).
RELAYER_PRIVATE_KEY=0xyour_relayer_private_key

# --- Data providers ---
# Covalent / GoldRush: https://goldrush.dev — used for cross-chain wallet volume.
COVALENT_API_KEY=
# Comma-separated Covalent chain names to check volume across.
# Defaults to a representative EVM set if unset — see src/eligibility/volume.ts.
VOLUME_CHECK_CHAINS=

# Alchemy: https://www.alchemy.com — used for Ethereum-mainnet NFT ownership and current
# floor value (via alchemy-sdk, using ETH_MAINNET_RPC_URL's key).
ALCHEMY_API_KEY=

# CoinGecko Pro API key (optional) — used for the 6-month sustained floor-price-history check
# (src/eligibility/nft.ts). CoinGecko's daily NFT historical-data endpoint is Pro-only (paid,
# see https://www.coingecko.com/en/api/pricing); leave this unset to use the free fallback
# instead, which approximates the same check from free 30d/60d/1y %-change data (coarser, but
# no cost). Setting this upgrades to the accurate daily-history version automatically.
COINGECKO_API_KEY=
